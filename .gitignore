# [Gitignore](https://git-scm.com/docs/gitignore)

# Personal configs (if any)
backup/
personal/
private/

# AI agent (claude code / Codex)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Documents
docs/

# Dependencies (eg. Node.js)
node_modules/
.yarn/
.cache/
yarn.lock
package-lock.json

# Build / generate output
dist/
build/
*.tgz

# Environment variable
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Logs
logs
*.log*

# Tests / e2e / reports
tests/**/coverage/
tests/**/reports
coverage/
.nyc_output/

# IDEs and Editors
.idea/
.vscode/
*.suo
*.swp
*.swo
*.ntvs*
*.njsproj
*.sln
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Temporary files
tmp/
temp/
.temp/
*.tmp
*.bak
*.backup

# Misc
.git/

# System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini